[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://scenes/background.tscn" id="2_bg"]

[node name="Menu" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" parent="." instance=ExtResource("2_bg")]

[node name="Title" type="Label" parent="."]
anchor_right = 1.0
offset_top = 190.0
offset_bottom = 300.0
theme_override_colors/font_color = Color(0.2, 0.8, 1, 1)
theme_override_colors/font_outline_color = Color(0.05, 0.25, 0.4, 1)
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 84
text = "GRAVISHIFT"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Subtitle" type="Label" parent="."]
anchor_right = 1.0
offset_top = 300.0
offset_bottom = 350.0
theme_override_colors/font_color = Color(0.6, 0.65, 0.8, 1)
theme_override_font_sizes/font_size = 28
text = "Controla la gravedad"
horizontal_alignment = 1

[node name="MainPanel" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -80.0
offset_right = 240.0
offset_bottom = 430.0
theme_override_constants/separation = 28

[node name="PlayButton" type="Button" parent="MainPanel"]
custom_minimum_size = Vector2(0, 110)
focus_mode = 0
theme_override_font_sizes/font_size = 40
text = "Jugar"

[node name="LevelsButton" type="Button" parent="MainPanel"]
custom_minimum_size = Vector2(0, 100)
focus_mode = 0
text = "Niveles"

[node name="ModeButton" type="Button" parent="MainPanel"]
custom_minimum_size = Vector2(0, 100)
focus_mode = 0
text = "Control: deslizar"

[node name="SoundButton" type="Button" parent="MainPanel"]
custom_minimum_size = Vector2(0, 100)
focus_mode = 0
text = "Sonido: sí"

[node name="LevelsPanel" type="VBoxContainer" parent="."]
visible = false
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -220.0
offset_right = 260.0
offset_bottom = 460.0
theme_override_constants/separation = 36

[node name="LevelsTitle" type="Label" parent="LevelsPanel"]
theme_override_font_sizes/font_size = 40
text = "Niveles"
horizontal_alignment = 1

[node name="LevelGrid" type="GridContainer" parent="LevelsPanel"]
size_flags_horizontal = 4
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 24
columns = 3

[node name="BackButton" type="Button" parent="LevelsPanel"]
custom_minimum_size = Vector2(280, 100)
size_flags_horizontal = 4
focus_mode = 0
text = "Volver"

[node name="VersionLabel" type="Label" parent="."]
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -70.0
offset_bottom = -30.0
theme_override_colors/font_color = Color(0.4, 0.43, 0.55, 1)
theme_override_font_sizes/font_size = 20
text = "v0.2.0"
horizontal_alignment = 1

[connection signal="pressed" from="MainPanel/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="MainPanel/LevelsButton" to="." method="_on_levels_pressed"]
[connection signal="pressed" from="MainPanel/ModeButton" to="." method="_on_mode_pressed"]
[connection signal="pressed" from="MainPanel/SoundButton" to="." method="_on_sound_pressed"]
[connection signal="pressed" from="LevelsPanel/BackButton" to="." method="_on_back_pressed"]
